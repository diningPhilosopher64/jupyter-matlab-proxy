{
    "name": "MATLAB & Jupyter MATLAB Proxy",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "args": {
            "PYTHON_VERSION" : "3.11",
            "NVM_VERSION" : "0.40.3",
            "NODE_VERSION" : "24",
            "MATLAB_RELEASE" : "R2025b",
            "UBUNTU_VERSION" : "24.04",
            "MATLAB_PRODUCT_LIST" : "MATLAB"
        }
    },
    "containerEnv": {
        "NPM_CONFIG_REGISTRY": "${localEnv:NPM_CONFIG_REGISTRY}",
        "MWI_SESSION_NAME": "DevContainer"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "MathWorks.language-matlab"
            ],
            "settings": {
                "MATLAB.signIn": true,
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": ".venv/bin/python"
            }
        }
    },
    "postCreateCommand": "UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_TOOL_BIN_DIR=/usr/local/bin UV_TOOL_DIR=/opt/uv-tools uv tool install jupyterlab --with .devcontainer/with-matlab/jupyter_matlab_proxy-0.17.5-py3-none-any.whl --force",
    "waitFor": "postCreateCommand"
}